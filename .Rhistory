library(leaflet)
library(sf)

trans_proba <- function(x, p = 3) {
  val_min <- exp(-0.5 * p)
  val_max <- exp(0.5 * p)
  val <- exp((x - 0.5) * p)
  (val - val_min) / (val_max - val_min)
}

inv_trans_proba <- function(y, p = 3) {
  val_min <- exp(-0.5 * p)
  val_max <- exp(0.5 * p)
  y_clamped <- pmin(pmax(y, 0), 1)
  val <- y_clamped * (val_max - val_min) + val_min
  0.5 + (1 / p) * log(val)
}

pal_base <- leaflet::colorNumeric(
  palette = "BuPu",
  domain = c(0, 1)
)

leaflet(data = sub_sf) %>%
  addTiles() %>%
  addPolygons(
    group = "polys",
    stroke = TRUE,
    weight = 0.8,
    color = "#ffffff",
    fillColor = ~pal_base(trans_proba(valeur)),
    fillOpacity = 0.8,
    highlightOptions = highlightOptions(weight = 2, color = "#333", bringToFront = TRUE)
  ) %>%
  addLegend(
    pal = pal_base,
    values = c(0, 1), # Étendue fixe [0, 1]
    title = "Titre de test",
    position = "bottomright",
    opacity = 0.8,
    # Re-transforme dynamiquement chaque cran calculé par Leaflet
    labFormat = leaflet::labelFormat(
      transform = function(x) inv_trans_proba(x),
      digits = 2
    )
  )
