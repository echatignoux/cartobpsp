trans_proba <- function(x, p = 3) {
  val <- exp(x - 0.5)^p
  val_min <- exp(-0.5)^p
  val_max <- exp(0.5)^p
  (val - val_min) / (val_max - val_min)
}

inv_trans_proba <- function(y, p = 3) {
  val_min <- exp(-0.5)^p
  val_max <- exp(0.5)^p
  val <- y * (val_max - val_min) + val_min
  log(val^(1/p)) + 0.5
}

pal_base <- leaflet::colorNumeric(palette = "BuPu", domain = c(0, 1))

leaflet(data = sub_sf) %>%
  addTiles() %>%
  addPolygons(
    group = "polys",
    stroke = TRUE,
    weight = 0.8,
    color = "#ffffff",
    # On applique la transformation directe sur la carte
    fillColor = ~pal_base(trans_proba(valeur)),
    fillOpacity = 0.8,
    highlightOptions = highlightOptions(weight = 2, color = "#333", bringToFront = TRUE)
  ) %>%
  addLegend(
    pal = pal_base,
    values = c(0, 1), # Domaine de la palette transformée
    title = "Titre de test",
    position = "bottomright",
    opacity = 0.8,
    # Re-transforme les étiquettes pour afficher la vraie valeur
    labFormat = leaflet::labelFormat(
      transform = function(x) inv_trans_proba(x)
    )
  )
